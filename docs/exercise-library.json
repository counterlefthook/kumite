{
  "version": 2,
  "about": "Seed data for the Kumite exercises table. Each ladder lists exercises from easiest to hardest by rung. The engine moves up a ladder when load and reps are maxed out (see PLAN.md, Engine rules).",
  "units": {
    "load": "pounds per dumbbell",
    "reps": "per side for unilateral exercises",
    "seconds": "per side for side planks",
    "dumbbells": "how many dumbbells the exercise uses (0, 1, or 2)"
  },
  "groups": {
    "push": "chest, shoulders, triceps (weekly target)",
    "pull": "back, biceps (weekly target)",
    "squat": "quads (weekly target)",
    "hinge": "glutes, hamstrings (weekly target)",
    "core": "tracked, no weekly target",
    "arms": "tracked, no weekly target"
  },
  "templates": {
    "A": {
      "pairs": [
        [
          "pullup",
          "rdl"
        ],
        [
          "unilateral_squat",
          "bench"
        ]
      ],
      "finisher": "core_front",
      "optional_finisher": [
        "curl",
        "triceps"
      ]
    },
    "B": {
      "pairs": [
        [
          "box_squat",
          "shoulder_press"
        ],
        [
          "row",
          "hip_thrust"
        ]
      ],
      "finisher": "core_side",
      "optional_finisher": [
        "curl",
        "triceps"
      ]
    }
  },
  "knee_swaps": {
    "A": {
      "unilateral_squat": "hip_thrust"
    },
    "B": {
      "box_squat": "rdl"
    },
    "desk": {
      "chair_squat": "glute_bridge"
    }
  },
  "ladders": {
    "pullup": {
      "group": "pull",
      "progression": "pullup_stages",
      "note": "Stages and band steps are defined in PLAN.md. pullup_negative is the Stage 1 accessory."
    },
    "pullup_accessory": {
      "group": "pull",
      "progression": "none"
    },
    "rdl": {
      "group": "hinge",
      "progression": "double_progression"
    },
    "unilateral_squat": {
      "group": "squat",
      "progression": "double_progression"
    },
    "bench": {
      "group": "push",
      "progression": "double_progression"
    },
    "box_squat": {
      "group": "squat",
      "progression": "double_progression"
    },
    "shoulder_press": {
      "group": "push",
      "progression": "double_progression"
    },
    "row": {
      "group": "pull",
      "progression": "double_progression"
    },
    "hip_thrust": {
      "group": "hinge",
      "progression": "double_progression"
    },
    "core_front": {
      "group": "core",
      "progression": "holds"
    },
    "core_side": {
      "group": "core",
      "progression": "holds"
    },
    "curl": {
      "group": "arms",
      "progression": "double_progression"
    },
    "triceps": {
      "group": "arms",
      "progression": "double_progression"
    },
    "desk": {
      "group": "mixed",
      "progression": "mini_sets",
      "note": "Desk exercises are a menu, not a ladder. Rung is display order."
    }
  },
